@inherits LayoutComponentBase

<div class="admin-app-shell">
    <aside class="admin-sidebar">
        <div class="admin-sidebar-brand">
            <a href="/admin" class="admin-brand-link">
                <span class="admin-brand-mark">AK</span>
                <span class="admin-brand-copy"><strong>Portfolio Admin</strong><small>Content & Growth</small></span>
            </a>
        </div>

        <nav class="admin-nav" aria-label="Admin navigation">
            <span class="admin-nav-label">OVERVIEW</span>
            <NavLink href="/admin" Match="NavLinkMatch.All"><span class="admin-nav-icon">⌂</span><span>Dashboard</span></NavLink>

            <span class="admin-nav-label">CONTENT</span>
            <NavLink href="/admin/blog"><span class="admin-nav-icon">✎</span><span>Blog</span></NavLink>
            <NavLink href="/admin/projects"><span class="admin-nav-icon">◇</span><span>Projects</span></NavLink>

            <span class="admin-nav-label">AUDIENCE</span>
            <NavLink href="/admin/subscribers"><span class="admin-nav-icon">◎</span><span>Subscribers</span></NavLink>
            <NavLink href="/admin/leads"><span class="admin-nav-icon">✉</span><span>Contact Leads</span></NavLink>

            <span class="admin-nav-label">INSIGHTS</span>
            <NavLink href="/admin/analytics"><span class="admin-nav-icon">↗</span><span>Analytics</span></NavLink>
            <NavLink href="/admin/settings"><span class="admin-nav-icon">⚙</span><span>Settings</span></NavLink>
        </nav>

        <div class="admin-sidebar-footer">
            <a class="admin-view-site" href="/" target="_blank" rel="noreferrer"><span>↗</span><span>View public website</span></a>
            <form method="post" action="/admin/logout">
                <button type="submit" class="admin-signout-button"><span>⇥</span><span>Sign out</span></button>
            </form>
        </div>
    </aside>

    <div class="admin-workspace">
        <header class="admin-workspace-header">
            <div class="admin-mobile-brand"><span class="admin-brand-mark">AK</span><strong>Admin</strong></div>
            <div class="admin-workspace-meta">
                <span class="admin-live-dot"></span>
                <span>Portfolio CMS</span>
            </div>
            <div class="admin-user-chip">
                <span class="admin-user-avatar">AK</span>
                <span><strong>Administrator</strong><small>Portfolio owner</small></span>
            </div>
        </header>

        <main class="admin-workspace-content">
            @Body
        </main>
    </div>
</div>
