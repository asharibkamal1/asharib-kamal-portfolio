@rendermode InteractiveServer
@inject ILeadCaptureService LeadCapture

<div class="newsletter-box reveal home-newsletter-signup">
    <span class="section-kicker">JOIN DOTNET GURU</span>
    <h2>Practical .NET lessons in your inbox.</h2>
    <p>Get useful notes on ASP.NET Core, APIs, architecture, SQL, performance and production engineering.</p>

    <div class="trust-strip">
        <span>ASP.NET Core</span>
        <span>C#</span>
        <span>APIs</span>
        <span>Architecture</span>
        <span>SQL</span>
    </div>

    <form class="newsletter-form" @onsubmit="SubscribeAsync" @onsubmit:preventDefault>
        <input type="email"
               @bind="Email"
               maxlength="320"
               autocomplete="email"
               placeholder="Enter your email address"
               aria-label="Email address" />
        <button class="button button-primary" type="submit" disabled="@IsSubmitting">
            @(IsSubmitting ? "Subscribing..." : "Join the newsletter")
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="newsletter-status @(IsSuccess ? "success" : "error")" role="status">@StatusMessage</div>
    }

    <p class="newsletter-privacy-note">No spam. Your email is used only for portfolio and DotNet Guru updates.</p>
</div>

@code {
    [Parameter] public string Source { get; set; } = "Homepage Newsletter";

    private string Email { get; set; } = string.Empty;
    private string StatusMessage { get; set; } = string.Empty;
    private bool IsSuccess { get; set; }
    private bool IsSubmitting { get; set; }

    private async Task SubscribeAsync()
    {
        StatusMessage = string.Empty;
        IsSuccess = false;

        if (string.IsNullOrWhiteSpace(Email) || !Email.Contains('@'))
        {
            StatusMessage = "Please enter a valid email address.";
            return;
        }

        try
        {
            IsSubmitting = true;
            var result = await LeadCapture.SubscribeAsync(Email, Source);
            IsSuccess = true;
            StatusMessage = result switch
            {
                NewsletterSignupResult.AlreadySubscribed => "You're already subscribed. Thanks for being part of DotNet Guru.",
                NewsletterSignupResult.Reactivated => "Welcome back. Your subscription is active again.",
                _ => "You're subscribed. Thanks for joining DotNet Guru."
            };
            Email = string.Empty;
        }
        catch
        {
            StatusMessage = "Subscription couldn't be saved right now. Please try again shortly.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
