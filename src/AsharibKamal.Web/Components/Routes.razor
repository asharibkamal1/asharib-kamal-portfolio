<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <LayoutView Layout="typeof(MainLayout)">
                    <section class="page-shell simple-page">
                        <p class="eyebrow">ADMIN</p>
                        <h1>Sign in required.</h1>
                        <p class="lede">This area is private and available only to the portfolio administrator.</p>
                        <a class="button button-primary" href="/admin/login">Go to admin login</a>
                    </section>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <section class="page-shell simple-page">
                <p class="eyebrow">404</p>
                <h1>That page doesn't exist.</h1>
                <p class="lede">The link may be outdated, or the page may have moved.</p>
                <a class="button button-primary" href="/">Back home</a>
            </section>
        </LayoutView>
    </NotFound>
</Router>
