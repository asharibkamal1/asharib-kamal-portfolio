@page "/"
@using AsharibKamal.Application.Abstractions
@inject IPortfolioService Portfolio

<PageTitle>Asharib Kamal — Senior .NET / Backend Engineer</PageTitle>
<HeadContent>
    <meta name="description" content="Asharib Kamal is a Senior .NET / Backend Engineer with 5+ years of experience building secure APIs, enterprise platforms and scalable systems." />
</HeadContent>

<section class="portfolio-hero">
    <div class="page-shell portfolio-hero-grid">
        <div class="portfolio-hero-copy reveal">
            <span class="section-kicker">PORTFOLIO</span>
            <h1>Engineering digital products that solve <span>real business problems.</span></h1>
            <p>I’m Asharib Kamal, a Senior .NET / Backend Engineer with 5+ years of experience building enterprise applications, secure APIs and production systems.</p>
            <div class="hero-actions">
                <a class="button button-primary" href="/projects">View my work <span>→</span></a>
                <a class="button button-ghost" href="/contact">Start a project</a>
            </div>
            <div class="hero-metrics">
                <div><strong>5+</strong><span>Years Experience</span></div>
                <div><strong>.NET</strong><span>Backend Specialist</span></div>
                <div><strong>Enterprise</strong><span>Production Systems</span></div>
            </div>
        </div>

        <div class="portfolio-profile reveal" data-delay="100">
            <div class="profile-network" aria-hidden="true"></div>
            <div class="profile-badge badge-one">.NET 10</div>
            <div class="profile-badge badge-two">C#</div>
            <div class="profile-badge badge-three">SQL Server</div>
            <div class="profile-badge badge-four">Azure</div>
            <div class="profile-photo-frame">
                <img src="/images/asharib-kamal.png" alt="Asharib Kamal" loading="eager" />
            </div>
            <div class="profile-caption">
                <strong>Asharib Kamal</strong>
                <span>Senior .NET / Backend Engineer</span>
            </div>
        </div>
    </div>
</section>

<section class="portfolio-section" id="projects">
    <div class="page-shell">
        <div class="section-top-row">
            <div>
                <span class="section-kicker">MY WORK</span>
                <h2>Featured Projects</h2>
            </div>
            <a class="text-link" href="/projects">View all projects →</a>
        </div>

        <div class="project-filter-row" aria-label="Project categories">
            <span class="filter-chip active">All</span>
            <span class="filter-chip">Web Applications</span>
            <span class="filter-chip">APIs & Services</span>
            <span class="filter-chip">Enterprise Systems</span>
            <span class="filter-chip">Desktop Apps</span>
        </div>

        <div class="portfolio-project-grid">
            @foreach (var project in Portfolio.GetFeaturedProjects().Take(4))
            {
                <article class="portfolio-project-card reveal">
                    <div class="project-preview">
                        <div class="project-preview-top"><span></span><span></span><span></span></div>
                        <div class="project-preview-body">
                            <div class="preview-sidebar"></div>
                            <div class="preview-main">
                                <div class="preview-line wide"></div>
                                <div class="preview-stats"><i></i><i></i><i></i></div>
                                <div class="preview-chart"></div>
                            </div>
                        </div>
                    </div>
                    <div class="project-card-body">
                        <span class="project-type">Enterprise Application</span>
                        <h3>@project.Title</h3>
                        <p>@project.Summary</p>
                        <div class="tag-row">
                            @foreach (var tech in project.Technologies.Take(4))
                            {
                                <span>@tech</span>
                            }
                        </div>
                        <a class="project-link" href="/projects/@project.Slug">View case study <span>→</span></a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="portfolio-section experience-section" id="experience">
    <div class="page-shell">
        <div class="section-top-row">
            <div>
                <span class="section-kicker">EXPERIENCE</span>
                <h2>My engineering journey</h2>
            </div>
            <p class="section-summary">From industrial ERP systems to enterprise platforms and national-scale tax systems.</p>
        </div>

        <div class="experience-timeline">
            @foreach (var item in Portfolio.GetExperience())
            {
                <article class="experience-row reveal">
                    <div class="experience-period">@item.Period</div>
                    <div class="experience-marker"><span></span></div>
                    <div class="experience-card">
                        <span>@item.Organization</span>
                        <h3>@item.Role</h3>
                        <p>@item.Summary</p>
                        <div class="tag-row">
                            @foreach (var highlight in item.Highlights.Take(4))
                            {
                                <span>@highlight</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="portfolio-section skills-section">
    <div class="page-shell">
        <div class="section-top-row">
            <div>
                <span class="section-kicker">TECH STACK</span>
                <h2>Tools I use to build production software</h2>
            </div>
        </div>
        <div class="skill-cluster-grid">
            <article class="skill-cluster"><span>Backend</span><h3>C# · ASP.NET Core · Web APIs · Worker Services</h3></article>
            <article class="skill-cluster"><span>Database</span><h3>SQL Server · Oracle · EF Core · Stored Procedures</h3></article>
            <article class="skill-cluster"><span>Architecture</span><h3>Clean Architecture · CQRS · REST · Security</h3></article>
            <article class="skill-cluster"><span>Delivery</span><h3>Azure DevOps · Git · IIS · CI/CD · Logging</h3></article>
        </div>
    </div>
</section>

<section class="portfolio-section writing-section">
    <div class="page-shell">
        <div class="section-top-row">
            <div>
                <span class="section-kicker">WRITING</span>
                <h2>Latest .NET insights</h2>
            </div>
            <a class="text-link" href="/blog">View all articles →</a>
        </div>
        <div class="portfolio-article-grid">
            @foreach (var article in Portfolio.GetLatestArticles().Take(3))
            {
                <a class="portfolio-article-card reveal" href="/blog/@article.Slug">
                    <div class="article-meta"><span>@article.Category</span><span>@article.ReadTime</span></div>
                    <h3>@article.Title</h3>
                    <p>@article.Summary</p>
                    <span class="project-link">Read article →</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="portfolio-section resources-section" id="resources">
    <div class="page-shell resource-grid">
        <div class="resource-card featured-resource reveal">
            <span class="section-kicker">FEATURED RESOURCE</span>
            <h2>.NET Interview Preparation Guide</h2>
            <p>Practical interview preparation covering C#, ASP.NET Core, APIs, architecture, SQL and senior-level concepts.</p>
            <a class="button button-primary" href="/contact">Get early access →</a>
        </div>
        <div class="resource-card reveal">
            <span class="section-kicker">NEWSLETTER</span>
            <h2>DotNet Guru</h2>
            <p>Practical .NET engineering notes, architecture ideas and lessons from real production systems.</p>
            <a class="text-link" href="https://www.linkedin.com/newsletters/dotnet-guru-7189522711310721025/" target="_blank" rel="noreferrer">Read on LinkedIn ↗</a>
        </div>
    </div>
</section>

<section class="portfolio-section product-section">
    <div class="page-shell product-cta reveal">
        <div>
            <span class="section-kicker">BUILDING PRODUCTS</span>
            <h2>AppraisalKaro</h2>
            <p>A modern employee performance appraisal platform I'm building alongside my engineering work.</p>
        </div>
        <a class="button button-primary" href="https://appraisalkaro.com/" target="_blank" rel="noreferrer">Explore AppraisalKaro ↗</a>
    </div>
</section>

<section class="portfolio-section final-cta-section">
    <div class="page-shell final-cta reveal">
        <div>
            <span class="section-kicker">LET'S WORK TOGETHER</span>
            <h2>Have a software project in mind?</h2>
            <p>Let's build something secure, maintainable and ready for production.</p>
        </div>
        <div class="hero-actions">
            <a class="button button-primary" href="/contact">Start a project →</a>
            <a class="button button-ghost" href="/about">About me</a>
        </div>
    </div>
</section>
