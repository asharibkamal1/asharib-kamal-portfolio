@page "/"
@using AsharibKamal.Application.Abstractions
@inject IPortfolioService Portfolio

<PageTitle>Asharib Kamal — Senior .NET / Backend Engineer</PageTitle>
<HeadContent>
    <meta name="description" content="Asharib Kamal is a Senior .NET / Backend Engineer with 5+ years of experience building secure APIs, enterprise platforms and scalable systems." />
</HeadContent>

<Hero3D />

<section class="marquee-wrap" aria-label="Core expertise">
    <div class="marquee-track">
        <span>C#</span><i>•</i><span>ASP.NET Core</span><i>•</i><span>Web APIs</span><i>•</i><span>SQL Server</span><i>•</i><span>Oracle</span><i>•</i><span>Architecture</span><i>•</i><span>Security</span><i>•</i><span>Performance</span>
        <span>C#</span><i>•</i><span>ASP.NET Core</span><i>•</i><span>Web APIs</span><i>•</i><span>SQL Server</span><i>•</i><span>Oracle</span><i>•</i><span>Architecture</span><i>•</i><span>Security</span><i>•</i><span>Performance</span>
    </div>
</section>

<section class="section page-shell" id="about">
    <div class="about-grid">
        <SectionHeading Eyebrow="My approach" Title="Backend depth. Product thinking. Production mindset." Description="I’ve worked across ERP, CRM, transport and national tax systems. That range shaped how I think about software: understand the business, keep the architecture intentional, and optimize for the real production environment." />
        <div class="principles-grid">
            <article class="principle-card reveal"><span>01</span><h3>Build for reality</h3><p>Security, failure modes, maintainability and operations are part of the feature.</p></article>
            <article class="principle-card reveal" data-delay="80"><span>02</span><h3>Keep it simple</h3><p>Architecture should reduce friction, not become another system to maintain.</p></article>
            <article class="principle-card reveal" data-delay="160"><span>03</span><h3>Own the outcome</h3><p>I care about what reaches users, not only what compiles on my machine.</p></article>
        </div>
    </div>
</section>

<section class="section section-tint">
    <div class="page-shell">
        <SectionHeading Eyebrow="Selected work" Title="Systems with real business weight." Description="A selection of enterprise and government-platform work from my engineering journey." />
        <div class="project-grid">
            @foreach (var project in Portfolio.GetFeaturedProjects().Take(4))
            {
                <a class="project-card reveal" href="/projects/@project.Slug">
                    <div class="project-topline"><span>Case study</span><span class="project-arrow">↗</span></div>
                    <div>
                        <h3>@project.Title</h3>
                        <p>@project.Summary</p>
                    </div>
                    <div class="tag-row">
                        @foreach (var tech in project.Technologies.Take(4))
                        {
                            <span>@tech</span>
                        }
                    </div>
                </a>
            }
        </div>
        <div class="section-action reveal"><a class="text-link" href="/projects">View all projects <span>→</span></a></div>
    </div>
</section>

<section class="section page-shell">
    <SectionHeading Eyebrow="Journey" Title="From industrial ERP to national platforms." Description="A career built through hands-on delivery, technical ownership, mentoring and increasingly complex systems." />
    <div class="timeline">
        @foreach (var item in Portfolio.GetExperience())
        {
            <article class="timeline-item reveal">
                <div class="timeline-dot"></div>
                <div class="timeline-period">@item.Period</div>
                <div class="timeline-content">
                    <p class="timeline-org">@item.Organization</p>
                    <h3>@item.Role</h3>
                    <p>@item.Summary</p>
                    <div class="tag-row">@foreach (var highlight in item.Highlights) { <span>@highlight</span> }</div>
                </div>
            </article>
        }
    </div>
</section>

<section class="section section-dark">
    <div class="page-shell">
        <SectionHeading Eyebrow="How I can help" Title="Engineering support where it matters." Description="For teams that need experienced .NET delivery without unnecessary complexity." />
        <div class="services-grid">
            <a href="/services" class="service-card reveal"><span>01</span><h3>.NET Development</h3><p>Production-ready ASP.NET Core applications and backend services.</p><b>Explore service →</b></a>
            <a href="/services" class="service-card reveal" data-delay="80"><span>02</span><h3>API Engineering</h3><p>Secure REST APIs, integrations, authentication and backend workflows.</p><b>Explore service →</b></a>
            <a href="/services" class="service-card reveal" data-delay="160"><span>03</span><h3>Architecture & Review</h3><p>Practical architecture, modernization, performance and code review.</p><b>Explore service →</b></a>
        </div>
    </div>
</section>

<section class="section page-shell">
    <SectionHeading Eyebrow="Writing" Title="Notes from building with .NET." Description="Practical engineering ideas around APIs, architecture, performance, security and career growth." />
    <div class="article-grid">
        @foreach (var article in Portfolio.GetLatestArticles())
        {
            <a class="article-card reveal" href="/blog/@article.Slug">
                <div class="article-meta"><span>@article.Category</span><span>@article.ReadTime</span></div>
                <h3>@article.Title</h3>
                <p>@article.Summary</p>
                <span class="text-link">Read article →</span>
            </a>
        }
    </div>
</section>

<section class="section page-shell">
    <div class="product-banner reveal">
        <div>
            <p class="eyebrow">Building in public</p>
            <h2>AppraisalKaro</h2>
            <p>I'm building a modern employee performance appraisal product alongside my engineering work.</p>
        </div>
        <a class="button button-primary" href="https://appraisalkaro.com/" target="_blank" rel="noreferrer">Explore AppraisalKaro ↗</a>
    </div>
</section>

<section class="section page-shell">
    <div class="newsletter-panel reveal">
        <div>
            <p class="eyebrow">DotNet Guru</p>
            <h2>Practical .NET engineering, without the noise.</h2>
            <p>Architecture, APIs, performance and lessons from real production systems.</p>
        </div>
        <a class="button button-primary" href="https://www.linkedin.com/newsletters/dotnet-guru-7189522711310721025/" target="_blank" rel="noreferrer">Read the newsletter ↗</a>
    </div>
</section>
