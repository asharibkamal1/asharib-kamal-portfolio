@page "/projects/{Slug}"
@using AsharibKamal.Application.Abstractions
@using AsharibKamal.Application.DTOs
@inject IPublicProjectService PublicProjects
<PageTitle>@Title — Asharib Kamal</PageTitle>

@if (IsLoading)
{
    <section class="screen-body page-shell"><p>Loading project…</p></section>
}
else if (Project is null)
{
    <section class="screen-body page-shell"><h1>Project not found</h1><p>The requested case study is not published or is no longer available.</p><a class="text-link" href="/projects">← Back to portfolio</a></section>
}
else
{
    <section class="screen-hero"><div class="page-shell screen-hero-inner"><a class="back-link" href="/projects">← All Projects</a><span class="section-kicker">@(Project.IsFeatured ? "FEATURED CASE STUDY" : "CASE STUDY")</span><h1>@Project.Title</h1><p>@Project.Summary</p><div class="tag-row large-tags">@foreach (var tech in Project.Technologies){<span>@tech</span>}</div></div></section>
    <section class="screen-body page-shell">
        @if (!string.IsNullOrWhiteSpace(Project.CoverImageUrl))
        {
            <div class="public-project-detail-cover"><img src="@Project.CoverImageUrl" alt="@Project.Title project cover" /></div>
        }
        <div class="project-overview-card"><span class="section-kicker">PROJECT OVERVIEW</span><p>@Project.Description</p></div>
        <div class="screen-grid-2" style="margin-top:28px">
            <article class="screen-card"><span class="section-kicker">THE PROBLEM</span><h3>Business challenge</h3><p>@(string.IsNullOrWhiteSpace(Project.Problem) ? "The project required reliable workflows, secure data processing and maintainable engineering for a real production environment." : Project.Problem)</p></article>
            <article class="screen-card"><span class="section-kicker">MY ROLE</span><h3>Engineering contribution</h3><p>@(string.IsNullOrWhiteSpace(Project.Role) ? "My contribution focused on backend engineering, APIs, database integration, application logic and production support." : Project.Role)</p></article>
            <article class="screen-card"><span class="section-kicker">ENGINEERING</span><h3>Technical approach</h3><p>@(string.IsNullOrWhiteSpace(Project.Engineering) ? "The implementation emphasized maintainability, validation, observability, controlled data access and clear separation of responsibilities." : Project.Engineering)</p></article>
            <article class="screen-card"><span class="section-kicker">CONFIDENTIALITY</span><h3>Public case study</h3><p>@(string.IsNullOrWhiteSpace(Project.Confidentiality) ? "This case study intentionally avoids sensitive internal implementation details while showing the engineering scope and technologies involved." : Project.Confidentiality)</p></article>
        </div>
        <div class="final-cta" style="margin-top:45px"><div><span class="section-kicker">SIMILAR PROJECT?</span><h2>Let's discuss what you're building.</h2><p>I can help with .NET applications, APIs, modernization and backend architecture.</p></div><a class="button button-primary" href="/contact">Start a Conversation →</a></div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private PublicProjectDto? Project { get; set; }
    private bool IsLoading = true;
    private string Title => Project?.Title ?? "Project";
    protected override async Task OnParametersSetAsync(){IsLoading=true;Project=await PublicProjects.GetPublishedBySlugAsync(Slug);IsLoading=false;}
}
