@page "/projects/{Slug}"
@using AsharibKamal.Application.Abstractions
@using AsharibKamal.Application.DTOs
@inject IPortfolioService Portfolio
<PageTitle>@Title — Asharib Kamal</PageTitle>

@if (Project is null)
{
    <section class="screen-body page-shell"><h1>Project not found</h1><a class="text-link" href="/projects">← Back to portfolio</a></section>
}
else
{
    <section class="screen-hero"><div class="page-shell screen-hero-inner"><a class="back-link" href="/projects">← All Projects</a><span class="section-kicker">CASE STUDY</span><h1>@Project.Title</h1><p>@Project.Summary</p><div class="tag-row large-tags">@foreach (var tech in Project.Technologies){<span>@tech</span>}</div></div></section>
    <section class="screen-body page-shell">
        <div class="project-preview" style="height:360px;border-radius:22px;padding:24px"><div class="project-preview-top"><span></span><span></span><span></span></div><div class="project-preview-body" style="height:290px;grid-template-columns:70px 1fr"><div class="preview-sidebar"></div><div class="preview-main" style="padding:22px"><div class="preview-line wide"></div><div class="preview-stats" style="margin:22px 0"><i style="height:60px"></i><i style="height:60px"></i><i style="height:60px"></i></div><div class="preview-chart" style="height:140px"></div></div></div></div>
        <div class="screen-grid-2" style="margin-top:28px">
            <article class="screen-card"><span class="section-kicker">THE PROBLEM</span><h3>Complex business workflows</h3><p>The project required reliable backend workflows, secure data processing and integrations that could operate in a real enterprise environment.</p></article>
            <article class="screen-card"><span class="section-kicker">MY ROLE</span><h3>Backend & .NET engineering</h3><p>My contribution focused on application logic, APIs, database integration, security, reporting and production support appropriate to the project.</p></article>
            <article class="screen-card"><span class="section-kicker">ENGINEERING</span><h3>Production-first implementation</h3><p>The implementation emphasizes maintainability, validation, observability, controlled data access and clear separation of responsibilities.</p></article>
            <article class="screen-card"><span class="section-kicker">CONFIDENTIALITY</span><h3>Safe public case study</h3><p>This portfolio intentionally avoids exposing sensitive internal implementation details while still showing the engineering scope and technologies involved.</p></article>
        </div>
        <div class="final-cta" style="margin-top:45px"><div><span class="section-kicker">SIMILAR PROJECT?</span><h2>Let's discuss what you're building.</h2><p>I can help with .NET applications, APIs, modernization and backend architecture.</p></div><a class="button button-primary" href="/contact">Start a Conversation →</a></div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private ProjectDto? Project => Portfolio.GetFeaturedProjects().FirstOrDefault(x => x.Slug == Slug);
    private string Title => Project?.Title ?? "Project";
}
